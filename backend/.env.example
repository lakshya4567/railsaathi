# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=indian_railway
ALLOWED_ORIGINS=http://localhost:5173

# --- AI journey assistant -------------------------------------------------
# Provider used by the assistant. Currently supported: gemini
AI_PROVIDER=gemini
# Create a key in Google AI Studio (https://aistudio.google.com/apikey).
# Keep it ONLY here (backend). Never put it in frontend code.
GEMINI_API_KEY=your-google-ai-studio-key-here
# Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait for the AI provider before showing an error.
AI_TIMEOUT_SECONDS=30
# Max assistant requests per minute per client IP (protects your API quota).
ASSISTANT_RATE_LIMIT_PER_MIN=20
